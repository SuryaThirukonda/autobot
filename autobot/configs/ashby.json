{
  "id": "ashby",
  "name": "Ashby",
  "urls": [
    "*://jobs.ashbyhq.com/*/application*",
    "*://jobs.ashbyhq.com/*",
    "*://*/*ashby_jid=*"
  ],
  "probes": [
    [
      "//input[@id='_systemfield_name' or @name='_systemfield_name']"
    ],
    [
      "//*[contains(@class, 'ashby-application-form')]"
    ]
  ],
  "container": [
    "//form[.//input[@id='_systemfield_name' or @id='_systemfield_email']]",
    "//input[@id='_systemfield_name' or @id='_systemfield_email']/ancestor::*[.//*[contains(@class, 'ashby-application-form-submit-button')]][1]",
    "//*[contains(@class, 'ashby-application-form-container')]/.."
  ],
  "containerExcluded": [
    "//*[contains(@class, 'ashby-application-form-autofill-uploader')]",
    "//*[contains(@class, 'ashby-application-form-autofill-input-root')]"
  ],
  "defaultMethod": "react",
  "fields": [
    {
      "key": "resume",
      "method": "upload",
      "actions": [
        {
          "path": [
            ".//input[@id='_systemfield_resume']",
            ".//*[contains(@class, 'ashby-application-form-field-entry')][./label[@for='_systemfield_resume']]//input[@type='file']",
            ".//*[contains(@class, 'ashby-application-form-field-entry')][./label[contains(translate(., 'RESUME', 'resume'), 'resume')]]//input[@type='file']"
          ]
        },
        {
          "delay": 2500
        }
      ],
      "allowFailure": true
    },
    {
      "key": "full_name",
      "path": [
        ".//input[@id='_systemfield_name']",
        ".//input[@name='_systemfield_name']"
      ]
    },
    {
      "key": "email",
      "path": [
        ".//input[@id='_systemfield_email']",
        ".//input[@name='_systemfield_email']",
        ".//*[contains(@class, 'ashby-application-form-field-entry')]//input[@type='email']"
      ]
    },
    {
      "key": "phone",
      "path": [
        ".//input[@id='_systemfield_phone']",
        ".//*[contains(@class, 'ashby-application-form-field-entry')]//input[@type='tel']",
        ".//*[contains(@class, 'ashby-application-form-field-entry')][./label[contains(translate(., 'PHONE', 'phone'), 'phone')]]//input[not(@type='hidden')]"
      ],
      "allowFailure": true
    },
    {
      "key": "location",
      "method": "combobox",
      "path": [
        ".//input[@id='_systemfield_location']",
        ".//*[contains(@class, 'ashby-application-form-field-entry')][./label[@for='_systemfield_location']]//input[not(@type='hidden')]"
      ],
      "allowFailure": true,
      "optionsPath": [
        "css:[role=listbox] [role=option]"
      ]
    },
    {
      "key": "linkedin",
      "path": [
        ".//label[contains(translate(., 'LINKEDIN', 'linkedin'), 'linkedin')]/following::input[1]"
      ],
      "allowFailure": true
    },
    {
      "key": "github",
      "path": [
        ".//label[contains(translate(., 'GITHUB', 'github'), 'github')]/following::input[1]"
      ],
      "allowFailure": true
    },
    {
      "key": "portfolio",
      "path": [
        ".//label[contains(translate(., 'PORTFOLIO', 'portfolio'), 'portfolio') or contains(translate(., 'WEBSITE', 'website'), 'website')]/following::input[1]"
      ],
      "allowFailure": true
    }
  ],
  "submit": [
    ".//button[@type='submit' and contains(., 'Submit')]",
    ".//button[contains(@class, 'ashby-application-form-submit-button')]"
  ],
  "success": [
    ".//*[contains(., 'Application submitted') or contains(., 'Thank you for applying')]"
  ]
}