{
  "manifest_version": 3,
  "name": "Autobot",
  "short_name": "Autobot",
  "version": "0.1.0",
  "description": "Deterministic job-application autofill. Local profile, config-driven ATS plans, heuristic fallback. No AI, no server.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Autobot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_page": "options.html",
  "commands": {
    "trigger-autofill": {
      "description": "Autofill the current application page",
      "suggested_key": { "default": "Alt+Shift+A" }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "engine/util.js",
        "engine/xpath.js",
        "engine/profile.js",
        "engine/detect.js",
        "engine/heuristics.js",
        "engine/writer.js",
        "engine/plan.js",
        "engine/panel.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    { "resources": ["page.js", "configs/*.json"], "matches": ["<all_urls>"] }
  ]
}
